#!/usr/bin/env python3
"""Finite, opt-in built-binary complete-log resource smoke; no third-party dependencies.

Nine fresh invocations (run generic, summarize generic, summarize vitest at exactly
1, 8 and 32 MiB) plus one fresh MCP session with two overlapping 8 MiB generic runs.
Correctness and completion within each watchdog gate the smoke; Gaori-PID peak
physical footprint and elapsed time are observations, never a pass/fail threshold.
"""
import ctypes
import hashlib
import json
import os
from pathlib import Path
import platform
import select
import subprocess
import sys
import tempfile
import time

MIB = 1024 * 1024
CHUNK = 32 * 1024
WATCHDOG = 120
MCP_SESSION = 240
PROGRESS = 10
SIZES = (1, 8, 32)
ROWS = ("run-generic", "summarize-generic", "summarize-vitest")
SCRIPT = str(Path(__file__).resolve())
VITEST_FIXTURE = Path(SCRIPT).parent.parent / "internal" / "extract" / "testdata" / "vitest.raw.log"

# Pinned generator constants and oracles (FLOG-012 plan v2/v4 and appendix A).
GENERIC_HEAD = b"Error: memory-probe\n"
REMAINDER = {b"neutral": b"nnn\n", b"neutral-a": b"nnnnnnn\n", b"neutral-b": b"nnnnnnn\n"}
VITEST_FIXTURE_BYTES = 348
VITEST_FIXTURE_SHA256 = "sha256:80838627f450efc1cfbfb49499a747fafb2aab4cb449234f73612991842f204b"
GENERIC_SIGNATURE = "Error: memory-probe"
VITEST_SIGNATURE = "AssertionError: expected false to be true"
EXCERPT_SHA256 = {
    b"neutral": (115, "sha256:d5106ef007bf039fc40874fa7865fd1368b042f3b318b549a4224a3b948f36f4"),
    b"neutral-a": (139, "sha256:42a7d9c64c176a20c2225a62d049a01e7d07aa7e98c3ba5b15ccab2a23c6b8a1"),
    b"neutral-b": (139, "sha256:33fb09046bd1829d05681c6af97b0977b2bcf1b469b462fba15e6f1974d1a5db"),
    "vitest": (236, "sha256:d8a7bbbdcf80c5f8eab017b9e0611f4562e937616ed8a817182e3a7621560ba4"),
}
MCP_RAW_SHA256 = {
    b"neutral-a": "sha256:a4c1d631f6cdbc8c14ba012d5de3ec1b675e44e44dbddc1ad2ee4c500058ce74",
    b"neutral-b": "sha256:d3174c9290196c8222e512de4655e521a8d174ba9d80ee1dcbd255b96e5309f5",
}


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def milestone(event, **fields):
    print(json.dumps(dict(record="milestone", event=event, **fields)), flush=True)


def repeated(token, count):
    block = token * max(1, CHUNK // len(token))
    while count:
        piece = block[:min(count, len(block))]
        yield piece
        count -= len(piece)


def neutral_lines(size, variant):
    """size bytes of complete candidate-free lines ending in the pinned remainder line."""
    line = variant + b"\n"
    remainder = REMAINDER[variant]
    count, extra = divmod(size, len(line))
    require(extra == len(remainder), "unpinned generator remainder")
    yield from repeated(line, count * len(line))
    yield remainder


def generic_chunks(size, variant=b"neutral"):
    yield GENERIC_HEAD
    yield from neutral_lines(size - len(GENERIC_HEAD), variant)


def vitest_chunks(size, fixture):
    yield from neutral_lines(size - len(fixture), b"neutral")
    yield fixture


def digest_chunks(parts, writer=None):
    digest, count = hashlib.sha256(), 0
    for part in parts:
        digest.update(part)
        count += len(part)
        if writer is not None:
            require(writer.write(part) == len(part), "short fixture write")
    return count, "sha256:" + digest.hexdigest()


def file_digest(path):
    with path.open("rb") as source:
        return digest_chunks(iter(lambda: source.read(CHUNK), b""))


def bounded_bytes(path, limit=64 * 1024):
    with path.open("rb") as source:
        data = source.read(limit + 1)
    require(len(data) <= limit, "oversized derived evidence: " + path.name)
    return data


def sha(data):
    return "sha256:" + hashlib.sha256(data).hexdigest()


class RUsageV4(ctypes.Structure):
    # Darwin sys/resource.h: UUID, then 35 uint64 fields; lifetime peak is #28.
    _fields_ = [("uuid", ctypes.c_uint8 * 16), ("values", ctypes.c_uint64 * 35)]


class MeasuredProcess:
    """Read the process-local lifetime peak at NOTE_EXIT, before reaping."""
    def __init__(self, argv, repo, stdout, stderr, deadline, label, stdin=subprocess.DEVNULL):
        require(sys.platform == "darwin", "resource instrumentation requires macOS; other platforms are unmeasured")
        self.lib = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
        self.lib.proc_pid_rusage.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
        self.lib.proc_pid_rusage.restype = ctypes.c_int
        self.label, self.deadline = label, deadline
        self.queue = select.kqueue()
        self.started = time.monotonic()
        self.process = subprocess.Popen(argv, cwd=repo, stdin=stdin, stdout=stdout, stderr=stderr)
        try:
            event = select.kevent(self.process.pid, filter=select.KQ_FILTER_PROC,
                                  flags=select.KQ_EV_ADD | select.KQ_EV_ENABLE | select.KQ_EV_ONESHOT,
                                  fflags=select.KQ_NOTE_EXIT)
            self.queue.control([event], 0, 0)
        except BaseException:
            self.abort()
            raise

    def peak(self):
        value = RUsageV4()
        result = self.lib.proc_pid_rusage(self.process.pid, 4, ctypes.byref(value))
        require(result == 0, "proc_pid_rusage failed: errno=" + str(ctypes.get_errno()))
        peak = value.values[28]
        require(peak > 0, "process-local lifetime peak is unavailable")
        return peak

    def remaining(self):
        remaining = self.deadline - time.monotonic()
        require(remaining > 0, f"{self.label}: watchdog expired")
        return remaining

    def finish(self):
        milestone("wait", label=self.label)
        while True:
            events = self.queue.control(None, 1, min(PROGRESS, self.remaining()))
            if events:
                break
            milestone("progress", label=self.label, elapsed_seconds=round(time.monotonic() - self.started, 1))
        require(events[0].fflags & select.KQ_NOTE_EXIT, f"{self.label}: unexpected process event")
        elapsed = time.monotonic() - self.started
        # Popen.poll/communicate/wait would reap the process and lose this metric.
        peak = self.peak()
        code = self.process.wait(timeout=5)
        self.queue.close()
        return {"peak_bytes": peak, "gaori_seconds": round(elapsed, 3), "process_exit": code}

    def abort(self):
        # Only exceptional cleanup uses poll implicitly. Failed probes never pass.
        if self.process.returncode is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait(timeout=5)
        self.queue.close()


def config(repo, argv):
    directory = repo / ".gaori"
    directory.mkdir()
    (directory / "tester.yaml").write_text(json.dumps({"version": 2, "commands": {
        "unit": {"command": argv, "tags": ["memory"], "parser": "generic", "timeout_sec": WATCHDOG}
    }}))


def emit_argv(size, variant="neutral", barrier=None):
    argv = [sys.executable, SCRIPT, "emit", str(size), variant]
    if barrier:
        argv.append(str(barrier))
    return argv


def owned_path(repo, relative):
    path = (repo / relative).resolve()
    require(path.is_relative_to(repo.resolve()), "artifact escaped probe root")
    require(path.is_file(), "artifact is missing")
    return path


def expected_failure(row, size, variant):
    """Exact retained failure for a row: span, metadata, signature and excerpt."""
    if row == "summarize-vitest":
        lines_before = (size - VITEST_FIXTURE_BYTES) // 8 + 1
        return {"raw_span": {"start_line": lines_before + 7, "end_line": lines_before + 14,
                             "start_byte": size - 237, "end_byte": size - 1},
                "file": "src/foo.ts", "line": 42, "test_name": "renders empty state",
                "signature": VITEST_SIGNATURE, "extractor": "precise", "parser": "vitest",
                "excerpt": EXCERPT_SHA256["vitest"]}
    line = len(variant) + 1
    return {"raw_span": {"start_line": 1, "end_line": 13, "start_byte": 0, "end_byte": len(GENERIC_HEAD) + 12 * line - 1},
            "file": None, "line": None, "test_name": None,
            "signature": GENERIC_SIGNATURE, "extractor": "partial", "parser": "generic",
            "excerpt": EXCERPT_SHA256[variant]}


def verify_artifacts(repo, result, row, size, expected_hash, variant=b"neutral"):
    want = expected_failure(row, size, variant)
    raw = owned_path(repo, result["raw_log"])
    require(file_digest(raw) == (size, expected_hash), "raw size/hash mismatch")
    summary_path = owned_path(repo, result["summary_json"])
    summary_bytes = bounded_bytes(summary_path)
    summary = json.loads(summary_bytes)
    status = json.loads(bounded_bytes(owned_path(repo, result["status_json"])))
    bounded_bytes(owned_path(repo, result["summary_markdown"]))
    for evidence in (result, summary, status):
        require(evidence["status"] == "failed" and evidence["exit_code"] == 1, "verdict changed")
        require(evidence["extractor_status"] == want["extractor"], "unexpected extractor status")
    require(summary["parser"] == want["parser"], "parser selection changed")
    require(summary["failure_count"] == 1 and summary["warning_count"] == 0, "unexpected extraction counts")
    require(not summary.get("failures_truncated") and not summary.get("warnings_truncated"), "evidence truncated")
    require(summary["raw_log_sha256"] == status["raw_log_sha256"] == expected_hash, "published raw digest mismatch")
    require(status["summary_sha256"] == sha(summary_bytes), "summary checksum mismatch")
    require(status["summary_path"] == result["summary_json"] and status["raw_log_path"] == result["raw_log"], "status locators changed")
    require(status["failure_signatures"] == [sha(want["signature"].encode())] and not status["warning_signatures"], "status signatures changed")
    fields = [status["command_id"], ",".join(status["tags"]), "failed", "1", want["extractor"], expected_hash,
              ",".join(status["failure_signatures"]), "", status["summary_path"], status["raw_log_path"]]
    require(status["status_hash"] == sha("\n".join(fields).encode()), "status hash mismatch")
    if row != "run-generic":
        require(not summary.get("command_argv") and "git_revision" not in summary and "git_dirty" not in summary,
                "summarize acquired execution provenance")
    failure = summary["failures"][0]
    require(failure["raw_span"] == want["raw_span"], "retained span changed: " + json.dumps(failure["raw_span"]))
    require(failure["signature"] == want["signature"] and failure.get("file") == want["file"]
            and failure.get("line") == want["line"] and failure.get("test_name") == want["test_name"], "failure metadata changed")
    excerpt = bounded_bytes(owned_path(repo, str(summary_path.parent.relative_to(repo) / failure["excerpt"])), 16 * 1024)
    require((len(excerpt), sha(excerpt)) == want["excerpt"], "excerpt bytes changed")
    return {"expected": "failed", "observed": summary["status"], "artifact_exit": 1, "failures": 1, "warnings": 0,
            "extractor_status": want["extractor"], "raw_bytes": size, "raw_sha256": expected_hash,
            "raw_span": failure["raw_span"], "excerpt_sha256": want["excerpt"][1],
            "integrity": "raw,summary,status,signature,span,metadata,excerpt verified"}


def disk_bytes(repo):
    return sum(path.stat().st_size for path in repo.rglob("*") if path.is_file())


def source_manifest(root):
    names = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=root)
    digest = hashlib.sha256()
    for name in sorted(set(names.split(b"\0")) - {b""}):
        path = Path(root) / os.fsdecode(name)
        if path.is_symlink():
            identity = "symlink:" + os.readlink(path)
        elif path.is_file():
            identity = str(path.stat().st_mode & 0o777) + ":" + file_digest(path)[1]
        else:
            identity = "absent"
        digest.update(name + b"\0" + identity.encode() + b"\0")
    return "sha256:" + digest.hexdigest()


def trial(binary, row, mib, fixture):
    size = mib * MIB
    label = f"{row}/{mib}MiB"
    started = time.monotonic()
    deadline = started + WATCHDOG
    milestone("start", label=label)
    with tempfile.TemporaryDirectory(prefix="gaori-memory-") as temporary:
        repo = Path(temporary).resolve()
        config(repo, emit_argv(size))
        if row == "run-generic":
            count, expected_hash = digest_chunks(generic_chunks(size))
            args = ["run", "unit"]
        else:
            chunks = generic_chunks(size) if row == "summarize-generic" else vitest_chunks(size, fixture)
            with (repo / "input.log").open("wb") as output:
                count, expected_hash = digest_chunks(chunks, output)
            args = ["summarize", "--parser", "generic" if row == "summarize-generic" else "vitest", "input.log"]
        require(count == size, "generator size mismatch")
        with (repo / "stdout.json").open("wb") as stdout, (repo / "stderr.txt").open("wb") as stderr:
            process = MeasuredProcess([binary, "--repo", str(repo), "--json"] + args, repo, stdout, stderr, deadline, label)
            try:
                measurement = process.finish()
            except BaseException:
                process.abort()
                raise
        require(measurement["process_exit"] == (1 if row == "run-generic" else 0), "unexpected process exit")
        require(not bounded_bytes(repo / "stderr.txt"), "unexpected stderr")
        result = json.loads(bounded_bytes(repo / "stdout.json"))
        evidence = verify_artifacts(repo, result, row, size, expected_hash)
        disk = disk_bytes(repo)
    row_seconds = time.monotonic() - started
    # Verification and temporary-root removal count against the same watchdog.
    require(row_seconds <= WATCHDOG, f"{label}: {WATCHDOG}-second row watchdog expired after cleanup")
    milestone("finish", label=label, row_seconds=round(row_seconds, 3))
    return dict(measurement, **evidence, scenario=row, input_mib=mib, row_seconds=round(row_seconds, 3), disk_bytes=disk)


class MCP:
    def __init__(self, measured):
        self.measured, self.sequence, self.buffer = measured, 0, b""
        self.wire_max = 0

    def send(self, value):
        data = json.dumps(value, separators=(",", ":")).encode() + b"\n"
        self.measured.process.stdin.write(data)
        self.measured.process.stdin.flush()

    def request(self, method, params):
        self.sequence += 1
        self.send({"jsonrpc": "2.0", "id": self.sequence, "method": method, "params": params})
        while True:
            while b"\n" not in self.buffer:
                ready, _, _ = select.select([self.measured.process.stdout], [], [], min(PROGRESS, self.measured.remaining()))
                if not ready:
                    milestone("progress", label=self.measured.label, waiting=method,
                              elapsed_seconds=round(time.monotonic() - self.measured.started, 1))
                    continue
                part = os.read(self.measured.process.stdout.fileno(), CHUNK)
                require(part, "MCP closed before response")
                self.buffer += part
                require(len(self.buffer) <= 128 * 1024, "unbounded MCP frame")
            line, self.buffer = self.buffer.split(b"\n", 1)
            self.wire_max = max(self.wire_max, len(line))
            require(b"neutral-a\\nneutral-a\\n" not in line and b"neutral-b\\nneutral-b\\n" not in line,
                    "raw stream leaked into MCP response")
            value = json.loads(line)
            if "id" not in value:
                continue
            require(value["id"] == self.sequence and "error" not in value, "MCP request failed")
            return value["result"]

    def tool(self, name, arguments):
        result = self.request("tools/call", {"name": name, "arguments": arguments})
        require(not result.get("isError"), "MCP tool failed: " + name)
        if "structuredContent" in result:
            return result["structuredContent"]
        return json.loads(result["content"][0]["text"])


def concurrent(binary):
    size = 8 * MIB
    label = "mcp-2x8MiB"
    started = time.monotonic()
    deadline = started + MCP_SESSION
    milestone("start", label=label)
    with tempfile.TemporaryDirectory(prefix="gaori-memory-mcp-") as temporary:
        repo = Path(temporary).resolve()
        config(repo, emit_argv(size, "neutral-a", repo / "ready-a"))
        hashes = [digest_chunks(generic_chunks(size, variant))[1] for variant in (b"neutral-a", b"neutral-b")]
        require(hashes == [MCP_RAW_SHA256[b"neutral-a"], MCP_RAW_SHA256[b"neutral-b"]], "MCP generator changed")
        with (repo / "stderr.txt").open("wb") as stderr:
            measured = MeasuredProcess([binary, "--repo", str(repo), "mcp"], repo, subprocess.PIPE, stderr, deadline, label, subprocess.PIPE)
            try:
                client = MCP(measured)
                client.request("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                              "clientInfo": {"name": "memory-campaign", "version": "1"}})
                client.send({"jsonrpc": "2.0", "method": "notifications/initialized"})
                initial_peak = measured.peak()
                starts = [client.tool("start_configured_run", {"command_id": "unit"}),
                          client.tool("start_ad_hoc_run", {"argv": emit_argv(size, "neutral-b", repo / "ready-b"),
                                                           "tags": ["memory"], "parser": "generic"})]
                require(starts[0]["invocation_id"] != starts[1]["invocation_id"], "concurrent identity collision")
                while not all((repo / name).exists() for name in ("ready-a", "ready-b")):
                    measured.remaining()
                    time.sleep(0.01)
                (repo / "release").touch()
                finals = [client.tool("await_run", {"invocation_id": start["invocation_id"]}) for start in starts]
                for start, final in zip(starts, finals):
                    require(final["invocation_id"] == start["invocation_id"] and final["phase"] == "finished" and not final.get("error"),
                            "MCP terminal identity/lifecycle changed")
                require(finals[0]["result"]["raw_log"] != finals[1]["result"]["raw_log"], "concurrent raw path collision")
                evidence = [verify_artifacts(repo, final["result"], "run-generic", size, digest, variant)
                            for final, digest, variant in zip(finals, hashes, (b"neutral-a", b"neutral-b"))]
                measured.process.stdin.close()
                measurement = measured.finish()
                measured.process.stdout.close()
            except BaseException:
                measured.abort()
                raise
        require(measurement["process_exit"] == 0 and not bounded_bytes(repo / "stderr.txt"), "MCP shutdown failed")
        disk = disk_bytes(repo)
    session_seconds = time.monotonic() - started
    # Initialize, starts, awaits, reconciliation, stdin close, reap and cleanup share one clock.
    require(session_seconds <= MCP_SESSION, f"{label}: {MCP_SESSION}-second session watchdog expired after cleanup")
    milestone("finish", label=label, session_seconds=round(session_seconds, 3))
    return dict(measurement, scenario=label, initial_peak_bytes=initial_peak, wire_max_bytes=client.wire_max,
                session_seconds=round(session_seconds, 3), independent_results=evidence, disk_bytes=disk)


def campaign(binary, root):
    require(sys.platform == "darwin", "resource instrumentation requires macOS; Linux is unmeasured, not skipped")
    fixture = VITEST_FIXTURE.read_bytes()
    require(sha(fixture) == VITEST_FIXTURE_SHA256 and len(fixture) == VITEST_FIXTURE_BYTES, "vitest fixture changed")
    source_identity = source_manifest(root)
    provenance = {"record": "provenance", "source_manifest_sha256": source_identity,
                  "source_commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip(),
                  "dirty_paths": subprocess.check_output(["git", "status", "--porcelain", "--untracked-files=all"], cwd=root, text=True).splitlines(),
                  "tracked_diff_sha256": sha(subprocess.check_output(["git", "diff", "HEAD", "--binary", "--full-index"], cwd=root)),
                  "harness_sha256": file_digest(Path(SCRIPT))[1], "binary_sha256": file_digest(Path(binary))[1],
                  "vitest_fixture_sha256": VITEST_FIXTURE_SHA256,
                  "gaori_version": json.loads(subprocess.check_output([binary, "version", "--json"], timeout=10)),
                  "go_version": subprocess.check_output(["go", "version"], text=True, timeout=10).strip(),
                  "os": platform.platform(), "architecture": platform.machine(), "python": platform.python_version(),
                  "metric": "proc_pid_rusage v4 ri_lifetime_max_phys_footprint before waitpid; bytes, Gaori PID only",
                  "row_watchdog_seconds": WATCHDOG, "mcp_session_seconds": MCP_SESSION, "progress_seconds": PROGRESS,
                  "rows": list(ROWS), "sizes_mib": list(SIZES), "threshold": "none (observation only)",
                  "command": "make test-memory"}
    print(json.dumps(provenance), flush=True)
    # One fresh invocation per row and size; no medians, pooling or retries.
    for row in ROWS:
        for mib in SIZES:
            print(json.dumps(dict(record="trial", **trial(binary, row, mib, fixture))), flush=True)
    print(json.dumps(dict(record="concurrency", **concurrent(binary))), flush=True)
    require(source_manifest(root) == source_identity, "source candidate changed during campaign")
    print(json.dumps({"record": "gate", "invocations": len(ROWS) * len(SIZES), "concurrent_sessions": 1, "outcome": "passed"}), flush=True)



def main():
    if len(sys.argv) in (4, 5) and sys.argv[1] == "emit":
        size, variant = int(sys.argv[2]), sys.argv[3].encode("ascii")
        if len(sys.argv) == 5:
            # The optional barrier proves overlap; it never outlives the MCP session budget.
            barrier = Path(sys.argv[4])
            barrier.touch()
            deadline = time.monotonic() + MCP_SESSION
            while not (barrier.parent / "release").exists():
                require(time.monotonic() < deadline, "producer barrier watchdog expired")
                time.sleep(0.01)
        digest_chunks(generic_chunks(size, variant), sys.stdout.buffer)
        sys.stdout.buffer.flush()
        return 1
    require(len(sys.argv) == 4 and sys.argv[1] == "campaign", "usage: test-memory campaign <gaori-binary> <source-root>")
    campaign(sys.argv[2], sys.argv[3])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:
        print(json.dumps({"record": "gate", "outcome": "failed", "error": str(error)}), flush=True)
        sys.exit(1)
